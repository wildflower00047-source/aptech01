{
  "name": "auth-server",
  "version": "1.0.0",
  "private": true,
  "description": "Hyper-modern MERN authentication & authorization API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:if-empty": "node src/scripts/seedIfEmpty.js",
    "lint": "eslint src --ext .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mern",
    "authentication",
    "authorization",
    "jwt",
    "rbac"
  ],
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^10.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "swagger-ui-dist": "^5.17.14",
    "ua-parser-js": "^1.0.38",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.8.0",
    "globals": "^15.8.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
