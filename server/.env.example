# ---------------------------------------------------------------------------
# AuthSec API — environment variables
# Copy to `.env` and adjust. Values shown are the built-in development defaults.
# In production (NODE_ENV=production) MONGO_URI, ACCESS_TOKEN_SECRET and
# REFRESH_TOKEN_SECRET are REQUIRED and the server refuses to boot without them.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/mern_auth

# --- URLs (used for CORS + links in emails) ---
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# --- Auth secrets (CHANGE THESE — generate strong random values) ---
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev_access_secret_change_me_please_000
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me_please_000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Cookies ---
# COOKIE_SECURE defaults to true when NODE_ENV=production. Set false for plain HTTP.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# --- Password hashing & lockout ---
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# --- Two-factor authentication ---
TWO_FA_ISSUER=AuthSec

# --- WebAuthn / passkeys ---
WEBAUTHN_RP_NAME=AuthSec
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Optional admin IP allowlist (comma-separated; empty = disabled) ---
ADMIN_IP_ALLOWLIST=

# --- Email (SMTP). Leave blank to log messages to the console instead. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=AuthSec <no-reply@authsec.dev>

# --- Seed admin (used by `npm run seed` / `seed:if-empty`) ---
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@authsec.dev
SEED_ADMIN_PASSWORD=Admin@12345

# --- Tests ---
MONGO_URI_TEST=mongodb://127.0.0.1:27017/authsec_test
