# ---------------------------------------------------------------------------
# Root environment for `docker compose` (see docker-compose.yml).
# Copy to `.env` and change the secrets before exposing anything publicly.
# ---------------------------------------------------------------------------

CLIENT_URL=http://localhost:8080
API_URL=http://localhost:5000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev_access_secret_change_me_please_000000
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me_please_000000

# Cookies require HTTPS; keep false for local HTTP.
COOKIE_SECURE=false

# WebAuthn / passkeys — must match the URL you open in the browser.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# Seed admin created on first boot.
SEED_ADMIN_EMAIL=admin@authsec.dev
SEED_ADMIN_PASSWORD=Admin@12345
