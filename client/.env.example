# ---------------------------------------------------------------------------
# AuthSec Web — environment variables
# Copy to `.env` (or `.env.local`). Only variables prefixed with VITE_ are
# exposed to the client bundle.
# ---------------------------------------------------------------------------

# Base URL for the API. Defaults to "/api" which is proxied to the backend by
# Vite in development and by nginx in the Docker image.
# Set this to a full URL (e.g. https://api.example.com/api) when the API is
# hosted on a different origin.
VITE_API_URL=/api
